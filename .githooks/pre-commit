#!/bin/sh
branch=$(git symbolic-ref --quiet --short HEAD) || exit 1
if ! printf '%s\n' "$branch" | grep -Eq '^(main|develop|(codex/)?(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)/[a-z0-9]+([/-][a-z0-9]+)*)$'; then
    echo 'Branch rejected: use [codex/]<type>/<kebab-case-description>.' >&2
    exit 1
fi
